FROM python:3.12-slim AS base

# 1. Rendszerfüggőségek telepítése
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev \
    && echo 'deb [trusted=yes] https://pkg.datadrivenconstruction.io stable main' > /etc/apt/sources.list.d/ddc.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends ddc-ifcconverter \
    && rm -rf /var/lib/apt/lists/*

# 2. Limitált jogosultságú felhasználó létrehozása
RUN groupadd -r oe && useradd -r -g oe -d /app -s /sbin/nologin oe

WORKDIR /app

# 3. A projekt leírásának és a teljes backend mappának a bemásolása
COPY README.md .
COPY backend/ backend/

# 4. Létrehozunk egy "ál" frontend mappát, hogy a telepítő (hatchling) megnyugodjon
RUN mkdir -p /app/frontend/dist && \
    touch /app/frontend/dist/index.html

# 5. Telepítés (a || true eltávolítva, és az asyncpg hozzáadva)
RUN pip install --no-cache-dir ./backend && \
    pip install --no-cache-dir "ezdxf>=0.18.0" asyncpg

# 6. Jogosultságok átadása (app mappa és locales mappa) majd felhasználóváltás
RUN chown -R oe:oe /app && \
    mkdir -p /usr/local/lib/python3.12/site-packages/locales && \
    chown -R oe:oe /usr/local/lib/python3.12/site-packages/locales
USER oe

# 7. A helyi Python binárisok (pl. uvicorn) hozzáadása a rendszer útvonalához
ENV PATH="/app/.local/bin:${PATH}"

# 8. Python optimalizációk
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

# 9. Egészségügyi ellenőrzés (Healthcheck)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1

# 10. A szerver indítása közvetlenül a Python modulon keresztül
CMD ["python", "-m", "uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
